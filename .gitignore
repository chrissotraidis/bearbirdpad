# macOS
.DS_Store

# Pinned upstream checkouts and build trees (created by scripts/, never committed)
sources/
build*/

# ROM data and ROM-derived generated sources — never committed, in any form
*.z64
*.v64
*.n64
RecompiledFuncs/
RecompiledPatches/
rsp/n_aspMain.cpp

# Local game saves — never committed
*.eep
*.sav
*.sra
*.srm
bk.n64.*.bin
bk.n64.*.bin.bak

# ref/ is local-only reference material (ROM, cloned repos, texture packs).
# Only its README is tracked.
ref/*
!ref/README.md
