{
  "schema_version": 1,
  "id": "bearbirdpad",
  "name": "BearBirdPad",
  "game": "Banjo-Kazooie (N64) via static recompilation",
  "kind": "disc-translation",
  "status": "experimental",
  "inputs": [
    {
      "type": "n64-rom",
      "formats": [
        "z64",
        "n64",
        "v64"
      ],
      "when": "build",
      "description": "Your own Banjo-Kazooie (USA) ROM (absolute path), read while preparing generated code."
    }
  ],
  "targets": {
    "ios": {
      "hosts": {
        "macos-arm64": "experimental"
      },
      "output": "ipa",
      "check": "ipa",
      "steps": [
        {
          "stage": "preflight",
          "command": [
            "/bin/bash",
            "{repo}/scripts/check-repo-safety.sh"
          ]
        },
        {
          "stage": "dependencies",
          "command": [
            "/bin/bash",
            "{repo}/scripts/fetch-sources.sh"
          ]
        },
        {
          "stage": "tools",
          "command": [
            "/bin/bash",
            "{repo}/scripts/build-host-tools.sh"
          ]
        },
        {
          "stage": "translate",
          "command": [
            "/bin/bash",
            "{repo}/scripts/prepare-generated.sh",
            "{disc}"
          ]
        },
        {
          "stage": "compile",
          "command": [
            "/bin/bash",
            "{repo}/scripts/build-ios.sh",
            "--device",
            "--app",
            "--config",
            "Release"
          ]
        },
        {
          "stage": "package",
          "command": [
            "/bin/bash",
            "{repo}/scripts/package-ios.sh",
            "{repo}/build-ios-app-device/Release/BanjoRecompiled.app",
            "{output}"
          ]
        }
      ],
      "tools": [
        "llvm"
      ]
    }
  },
  "requirements": {
    "disk_gb": 15,
    "tools": [
      {
        "name": "git",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "cmake",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "ninja",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "python3",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "xcodebuild",
        "version_args": [
          "-version"
        ],
        "note": "Install Xcode and its iOS platform"
      },
      {
        "name": "cargo",
        "version_args": [
          "--version"
        ],
        "note": "Rust builds the ROM decompressor: brew install rust"
      }
    ]
  },
  "publication": {
    "public_binaries": false,
    "reason": "Personal builds contain game code translated from the player's ROM; public releases are source only."
  }
}
