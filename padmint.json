{
  "schema_version": 2,
  "id": "bearbirdpad",
  "name": "BearBirdPad",
  "game": "Banjo-Kazooie (N64) via static recompilation",
  "kind": "disc-translation",
  "status": "experimental",
  "inputs": [
    {
      "type": "n64-rom",
      "formats": [
        "z64",
        "n64",
        "v64"
      ],
      "when": "build",
      "description": "Your own Banjo-Kazooie (USA) ROM (absolute path), read while preparing generated code."
    }
  ],
  "targets": {
    "ios": {
      "hosts": {
        "macos-arm64": "experimental",
        "windows-arm64": "experimental",
        "windows-x86_64": "experimental"
      },
      "output": "ipa",
      "check": "ipa",
      "steps": [
        {
          "stage": "preflight",
          "command": [
            "/bin/bash",
            "{repo}/scripts/check-repo-safety.sh"
          ],
          "on": [
            "macos"
          ]
        },
        {
          "stage": "dependencies",
          "command": [
            "/bin/bash",
            "{repo}/scripts/fetch-sources.sh"
          ],
          "on": [
            "macos"
          ]
        },
        {
          "stage": "tools",
          "command": [
            "/bin/bash",
            "{repo}/scripts/build-host-tools.sh"
          ],
          "on": [
            "macos"
          ]
        },
        {
          "stage": "translate",
          "command": [
            "/bin/bash",
            "{repo}/scripts/prepare-generated.sh",
            "{disc}"
          ],
          "on": [
            "macos"
          ]
        },
        {
          "stage": "compile",
          "command": [
            "/bin/bash",
            "{repo}/scripts/build-ios.sh",
            "--device",
            "--app",
            "--config",
            "Release"
          ],
          "on": [
            "macos"
          ]
        },
        {
          "stage": "package",
          "command": [
            "/bin/bash",
            "{repo}/scripts/package-ios.sh",
            "{repo}/build-ios-app-device/Release/BanjoRecompiled.app",
            "{output}"
          ],
          "on": [
            "macos"
          ]
        },
        {
          "stage": "compile",
          "command": [
            "{python}",
            "{repo}/scripts/build-game-module.py",
            "--rom",
            "{disc}",
            "--toolchain",
            "{ios_toolchain}",
            "--build-dir",
            "{work}",
            "--jobs",
            "{jobs}"
          ],
          "on": [
            "windows"
          ]
        }
      ],
      "tools": [
        "llvm",
        "git",
        "cmake",
        "ninja",
        "libcxx",
        "mips-clang"
      ],
      "published_app": "BearBirdPad-v{version}-ios-shell.ipa",
      "ios_module": {
        "file": "{work}/module/BearBirdPadGame.dylib",
        "into": "BearBirdPadGame.dylib",
        "on": [
          "windows"
        ]
      }
    }
  },
  "requirements": {
    "disk_gb": 15,
    "tools": [
      {
        "name": "git",
        "version_args": [
          "--version"
        ],
        "hosts": [
          "macos-arm64"
        ]
      },
      {
        "name": "cmake",
        "version_args": [
          "--version"
        ],
        "hosts": [
          "macos-arm64"
        ]
      },
      {
        "name": "ninja",
        "version_args": [
          "--version"
        ],
        "hosts": [
          "macos-arm64"
        ]
      },
      {
        "name": "python3",
        "version_args": [
          "--version"
        ],
        "hosts": [
          "macos-arm64"
        ]
      },
      {
        "name": "xcodebuild",
        "version_args": [
          "-version"
        ],
        "note": "Install Xcode and its iOS platform",
        "hosts": [
          "macos-arm64"
        ]
      },
      {
        "name": "xcrun",
        "label": "Metal Toolchain",
        "version_args": [
          "metal",
          "--version"
        ],
        "player": true,
        "note": "Install Xcode's Metal Toolchain: xcodebuild -downloadComponent MetalToolchain",
        "hosts": [
          "macos-arm64"
        ]
      },
      {
        "name": "cargo",
        "version_args": [
          "--version"
        ],
        "player": true,
        "note": "Rust builds the ROM decompressor: brew install rust",
        "hosts": [
          "macos-arm64"
        ]
      },
      {
        "name": "%ProgramFiles(x86)%/Microsoft Visual Studio/Installer/vswhere.exe",
        "version_args": [
          "-latest",
          "-products",
          "*",
          "-requiresAny",
          "-requires",
          "Microsoft.VisualStudio.Component.VC.Tools.x86.x64",
          "Microsoft.VisualStudio.Component.VC.Tools.ARM64",
          "-property",
          "installationVersion"
        ],
        "min_version": "17",
        "player": true,
        "hosts": [
          "windows-arm64"
        ],
        "label": "Visual Studio C++ Build Tools",
        "note": "Install Visual Studio 2022 Build Tools with Desktop development with C++ and a Windows SDK. x64 Windows needs x64/x86 C++ tools; Windows ARM64 can use ARM64 tools (preferred) or x64/x86 tools."
      },
      {
        "name": "%ProgramFiles(x86)%/Microsoft Visual Studio/Installer/vswhere.exe",
        "version_args": [
          "-latest",
          "-products",
          "*",
          "-requires",
          "Microsoft.VisualStudio.Component.VC.Tools.x86.x64",
          "-property",
          "installationVersion"
        ],
        "min_version": "17",
        "player": true,
        "hosts": [
          "windows-x86_64"
        ],
        "label": "Visual Studio C++ Build Tools",
        "note": "Install Visual Studio 2022 Build Tools with Desktop development with C++, x64/x86 C++ tools and a Windows SDK."
      }
    ]
  },
  "publication": {
    "public_binaries": false,
    "reason": "Private modules and personal apps contain code translated from the player-owned ROM. Public binary publication remains paused under the repository audit policy."
  },
  "notes": "Draft next-release module route. Requires PadMint portable SDK and managed MIPS compiler updates, plus a matching empty shell supplied with --app until an audited shell release exists. Existing manual Mac static build scripts remain supported. See docs/WINDOWS_MODULE.md for evidence and gates."
}
