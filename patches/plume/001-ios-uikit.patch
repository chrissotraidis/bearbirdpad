diff --git a/plume_uikit.mm b/plume_uikit.mm
new file mode 100644
index 0000000..f596404
--- /dev/null
+++ b/plume_uikit.mm
@@ -0,0 +1,115 @@
+//
+// plume
+//
+// Copyright (c) 2024 renderbag and contributors. All rights reserved.
+// Licensed under the MIT license. See LICENSE file for details.
+//
+
+#include "plume_apple.h"
+
+#import <QuartzCore/CAMetalLayer.h>
+#import <UIKit/UIKit.h>
+
+namespace plume {
+    RenderDeviceVendor getRenderDeviceVendor(uint64_t registryID) {
+        (void)registryID;
+        return RenderDeviceVendor::APPLE;
+    }
+
+    static void readWindowState(void *windowHandle, void *viewHandle, CocoaWindowAttributes &attributes, int &refreshRate) {
+        UIWindow *window = (__bridge UIWindow *)windowHandle;
+        CAMetalLayer *metalLayer = (__bridge CAMetalLayer *)viewHandle;
+        CGRect bounds = metalLayer != nil ? metalLayer.bounds : window.bounds;
+        CGFloat scale = metalLayer != nil ? metalLayer.contentsScale : window.screen.scale;
+        UIScreen *screen = window.windowScene.screen ?: window.screen;
+
+        attributes.x = 0;
+        attributes.y = 0;
+        attributes.width = (int)round(bounds.size.width * scale);
+        attributes.height = (int)round(bounds.size.height * scale);
+        refreshRate = screen != nil ? (int)screen.maximumFramesPerSecond : 60;
+    }
+
+    CocoaWindow::CocoaWindow(void *window, void *view)
+        : windowHandle(window), viewHandle(view), cachedRefreshRate(60) {
+        cachedAttributes = {0, 0, 0, 0};
+
+        if ([NSThread isMainThread]) {
+            int refreshRate = 60;
+            readWindowState(windowHandle, view, cachedAttributes, refreshRate);
+            cachedRefreshRate.store(refreshRate);
+        } else {
+            updateWindowAttributesInternal(true);
+            updateRefreshRateInternal(true);
+        }
+    }
+
+    CocoaWindow::~CocoaWindow() {}
+
+    void CocoaWindow::updateWindowAttributesInternal(bool forceSync) {
+        auto updateBlock = ^{
+            CocoaWindowAttributes freshAttributes{};
+            int refreshRate = 60;
+            readWindowState(windowHandle, viewHandle, freshAttributes, refreshRate);
+
+            std::lock_guard<std::mutex> lock(attributesMutex);
+            cachedAttributes = freshAttributes;
+        };
+
+        if (forceSync) {
+            dispatch_sync(dispatch_get_main_queue(), updateBlock);
+        } else {
+            dispatch_async(dispatch_get_main_queue(), updateBlock);
+        }
+    }
+
+    void CocoaWindow::updateRefreshRateInternal(bool forceSync) {
+        auto updateBlock = ^{
+            CocoaWindowAttributes attributes{};
+            int refreshRate = 60;
+            readWindowState(windowHandle, viewHandle, attributes, refreshRate);
+            cachedRefreshRate.store(refreshRate);
+        };
+
+        if (forceSync) {
+            dispatch_sync(dispatch_get_main_queue(), updateBlock);
+        } else {
+            dispatch_async(dispatch_get_main_queue(), updateBlock);
+        }
+    }
+
+    void CocoaWindow::getWindowAttributes(CocoaWindowAttributes *attributes) const {
+        if ([NSThread isMainThread]) {
+            CocoaWindowAttributes freshAttributes{};
+            int refreshRate = 60;
+            readWindowState(windowHandle, viewHandle, freshAttributes, refreshRate);
+
+            std::lock_guard<std::mutex> lock(attributesMutex);
+            const_cast<CocoaWindow *>(this)->cachedAttributes = freshAttributes;
+            *attributes = freshAttributes;
+        } else {
+            {
+                std::lock_guard<std::mutex> lock(attributesMutex);
+                *attributes = cachedAttributes;
+            }
+            const_cast<CocoaWindow *>(this)->updateWindowAttributesInternal(false);
+        }
+    }
+
+    int CocoaWindow::getRefreshRate() const {
+        if ([NSThread isMainThread]) {
+            CocoaWindowAttributes attributes{};
+            int refreshRate = 60;
+            readWindowState(windowHandle, viewHandle, attributes, refreshRate);
+            const_cast<CocoaWindow *>(this)->cachedRefreshRate.store(refreshRate);
+            return refreshRate;
+        }
+
+        const int refreshRate = cachedRefreshRate.load();
+        const_cast<CocoaWindow *>(this)->updateRefreshRateInternal(false);
+        return refreshRate;
+    }
+
+    void CocoaWindow::toggleFullscreen() {
+    }
+}
