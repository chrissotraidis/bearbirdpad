+#if defined(__APPLE__) && TARGET_OS_IPHONE
+extern "C" void banjopad_complete_ios_file_dialog(bool success, const char *path) {
+    std::function<void(bool, const std::filesystem::path&)> callback;
+    {
+        std::lock_guard lock(recompui::ios_file_dialog_mutex);
+        callback = std::move(recompui::ios_file_dialog_callback);
+        recompui::ios_file_dialog_callback = nullptr;
+    }
+
+    if (callback) {
+        const bool has_path = success && path != nullptr;
+        callback(has_path, has_path ? std::filesystem::path(path) : std::filesystem::path{});
+    }
+}
+
+extern "C" void banjopad_complete_ios_file_dialog_multiple(
+        bool success,
+        const char *const *paths,
+        size_t path_count) {
+    std::function<void(bool, const std::list<std::filesystem::path>&)> callback;
+    {
+        std::lock_guard lock(recompui::ios_file_dialog_mutex);
+        callback = std::move(recompui::ios_file_dialog_multiple_callback);
+        recompui::ios_file_dialog_multiple_callback = nullptr;
+    }
+
+    if (callback) {
+        std::list<std::filesystem::path> selected_paths;
+        if (success && paths != nullptr) {
+            for (size_t i = 0; i < path_count; i++) {
+                if (paths[i] != nullptr) {
+                    selected_paths.emplace_back(paths[i]);
+                }
+            }
+        }
+        callback(!selected_paths.empty(), selected_paths);
+    }
+}
+#endif
