+static void register_controller(SDL_GameController* controller) {
+    if (controller == nullptr) {
+        return;
+    }
+
+    if (SDL_GameControllerHasSensor(controller, SDL_SensorType::SDL_SENSOR_GYRO) &&
+        SDL_GameControllerHasSensor(controller, SDL_SensorType::SDL_SENSOR_ACCEL)) {
+        SDL_GameControllerSetSensorEnabled(controller, SDL_SensorType::SDL_SENSOR_GYRO, SDL_TRUE);
+        SDL_GameControllerSetSensorEnabled(controller, SDL_SensorType::SDL_SENSOR_ACCEL, SDL_TRUE);
+    }
+
+    ControllerGUID guid = profiles::get_guid_from_sdl_controller(controller);
+    if (profiles::get_controller_by_guid(guid) < 0) {
+        if (players::is_single_player_mode()) {
+            deferred_controller_profiles[guid.hash] = guid;
+        } else {
+            int profile_index = get_or_create_controller_profile_index(guid);
+            profiles::add_controller(guid, profile_index);
+        }
+    }
+}
+
+#if defined(__APPLE__) && TARGET_OS_IPHONE
+static bool controller_reconcile_active = true;
+
+static void reconcile_controllers(const char* reason) {
+    const auto opened = recompinput::reconcile_controller_states(reason);
+    for (SDL_GameController* controller : opened) {
+        register_controller(controller);
+    }
+    BearBirdPadTouch_SetControllerConnected(
+        recompinput::connected_controller_count() > 0 ? 1 : 0);
+}
+#endif
