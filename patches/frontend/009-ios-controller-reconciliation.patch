+std::vector<SDL_GameController*> recompinput::reconcile_controller_states(const char* reason) {
+    struct CurrentController {
+        int device_index;
+        SDL_JoystickID identity;
+        std::string name;
+    };
+
+    SDL_GameControllerUpdate();
+    std::vector<CurrentController> current;
+    const int joystick_count = SDL_NumJoysticks();
+    current.reserve(joystick_count > 0 ? static_cast<size_t>(joystick_count) : 0);
+    for (int device_index = 0; device_index < joystick_count; ++device_index) {
+        if (SDL_IsGameController(device_index) != SDL_TRUE) {
+            continue;
+        }
+        const SDL_JoystickID identity = SDL_JoystickGetDeviceInstanceID(device_index);
+        if (identity < 0) {
+            const char* name = SDL_GameControllerNameForIndex(device_index);
+            std::fprintf(
+                stderr,
+                "BEARBIRDPAD_CONTROLLER reconcile=%s device=%d identity=invalid name=%s\n",
+                reason,
+                device_index,
+                name != nullptr ? name : "unknown");
+            continue;
+        }
+        current.push_back({
+            device_index,
+            identity,
+            SDL_GameControllerNameForIndex(device_index) != nullptr
+                ? SDL_GameControllerNameForIndex(device_index)
+                : "unknown",
+        });
+    }
+
+    std::vector<SDL_JoystickID> identities;
+    identities.reserve(current.size());
+    for (const auto &controller : current) {
+        identities.push_back(controller.identity);
+    }
+
+    using Slots = bearbirdpad::controller::Slots<SDL_JoystickID, 4>;
+    std::vector<Slots::Change> changes;
+    std::vector<SDL_GameController*> to_close;
+    {
+        std::lock_guard lock{ InputState.controllers_mutex };
+        changes = InputState.controller_slots.reconcile(identities, [&](SDL_JoystickID identity) {
+            const auto state = InputState.controller_states.find(identity);
+            if (state == InputState.controller_states.end()) {
+                return true;
+            }
+            SDL_GameController* controller = state->second.controller;
+            if (!controller_is_attached(controller)) {
+                return false;
+            }
+            SDL_Joystick* joystick = SDL_GameControllerGetJoystick(controller);
+            return joystick != nullptr && SDL_JoystickInstanceID(joystick) == identity;
+        });
+
+        for (const auto &change : changes) {
+            if (change.kind != Slots::ChangeKind::Release) {
+                continue;
+            }
+            const auto state = InputState.controller_states.find(change.identity);
+            if (state != InputState.controller_states.end()) {
+                SDL_GameController* controller = state->second.controller;
+                std::fprintf(
+                    stderr,
+                    "BEARBIRDPAD_CONTROLLER reconcile=%s release player=%zu instance=%d name=%s\n",
+                    reason,
+                    change.slot + 1,
+                    change.identity,
+                    controller != nullptr && SDL_GameControllerName(controller) != nullptr
+                        ? SDL_GameControllerName(controller)
+                        : "unknown");
+                if (controller != nullptr) {
+                    std::erase(InputState.detected_controllers, controller);
+                    to_close.push_back(controller);
+                }
+                InputState.controller_states.erase(state);
+            }
+        }
+
+        const auto follow_up = InputState.controller_slots.reconcile(
+            identities, [](SDL_JoystickID) { return true; });
+        changes.insert(changes.end(), follow_up.begin(), follow_up.end());
+    }
+
+    for (SDL_GameController* controller : to_close) {
+        SDL_GameControllerClose(controller);
+        std::fprintf(
+            stderr,
+            "BEARBIRDPAD_CONTROLLER reconcile=%s close=ok\n",
+            reason);
+    }
+
+    std::vector<SDL_GameController*> opened;
+    for (const auto &change : changes) {
+        if (change.kind != Slots::ChangeKind::Assign) {
+            continue;
+        }
+
+        const auto device = std::find_if(
+            current.begin(), current.end(), [&](const CurrentController &candidate) {
+                return candidate.identity == change.identity;
+            });
+        if (device == current.end()) {
+            std::lock_guard lock{ InputState.controllers_mutex };
+            InputState.controller_slots.release(change.identity);
+            continue;
+        }
+
+        SDL_GameController* controller = SDL_GameControllerOpen(device->device_index);
+        if (controller == nullptr) {
+            std::fprintf(
+                stderr,
+                "BEARBIRDPAD_CONTROLLER reconcile=%s open=failed player=%zu device=%d instance=%d name=%s error=%s\n",
+                reason,
+                change.slot + 1,
+                device->device_index,
+                change.identity,
+                device->name.c_str(),
+                SDL_GetError());
+            std::lock_guard lock{ InputState.controllers_mutex };
+            InputState.controller_slots.release(change.identity);
+            continue;
+        }
+
+        SDL_Joystick* joystick = SDL_GameControllerGetJoystick(controller);
+        const SDL_JoystickID opened_identity =
+            joystick != nullptr ? SDL_JoystickInstanceID(joystick) : -1;
+        if (!controller_is_attached(controller) || opened_identity != change.identity) {
+            std::fprintf(
+                stderr,
+                "BEARBIRDPAD_CONTROLLER reconcile=%s open=invalid player=%zu device=%d expected=%d actual=%d\n",
+                reason,
+                change.slot + 1,
+                device->device_index,
+                change.identity,
+                opened_identity);
+            SDL_GameControllerClose(controller);
+            std::lock_guard lock{ InputState.controllers_mutex };
+            InputState.controller_slots.release(change.identity);
+            continue;
+        }
+
+        {
+            std::lock_guard lock{ InputState.controllers_mutex };
+            ControllerState &state = InputState.controller_states[change.identity];
+            state.controller = controller;
+        }
+        opened.push_back(controller);
+        std::fprintf(
+            stderr,
+            "BEARBIRDPAD_CONTROLLER reconcile=%s assign player=%zu device=%d instance=%d name=%s\n",
+            reason,
+            change.slot + 1,
+            device->device_index,
+            change.identity,
+            device->name.c_str());
+    }
+
+    if (!changes.empty() || std::string_view(reason) != "active-check") {
+        std::fprintf(
+            stderr,
+            "BEARBIRDPAD_CONTROLLER reconcile=%s connected=%zu\n",
+            reason,
+            recompinput::connected_controller_count());
+    }
+    return opened;
 }
 
+size_t recompinput::connected_controller_count() {
+    std::lock_guard lock{ InputState.controllers_mutex };
+    return InputState.controller_slots.connected_count();
+}
